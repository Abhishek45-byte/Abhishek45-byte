# Copy to .env and fill in.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# paper (default, fake money) or live (real Zerodha orders)
TRADING_MODE=paper
PAPER_CASH=100000

# Zerodha Kite Connect - needed for live mode and for F&O prices in paper mode.
# Access token expires daily; regenerate it each morning.
KITE_API_KEY=
KITE_ACCESS_TOKEN=

# Risk limits (rupees)
MAX_ORDER_VALUE=25000
MAX_QUANTITY=500
DAILY_LOSS_LIMIT=5000
REQUIRE_MARKET_OPEN=1
